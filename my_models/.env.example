# ================================================================
# SMIA Deployment Configuration — Vicomtech DII
# ================================================================
# USAGE:
#   cp .env.example .env
#   # Edit .env with real values for your deployment
#   docker compose build
#   docker compose up -d
#
# .env is listed in .gitignore and must NEVER be committed.
# This .env.example file IS committed as a template.
# ================================================================

# ── XMPP server ─────────────────────────────────────────────────
# Internal Erlang cluster cookie — any random string, keep secret
EJABBERD_COOKIE=change_me_in_production

# ── Machine 0 — fischertechnik crane (Case 0, original) ─────────
MACHINE0_AAS_FILE=LEGO_factory_case0.aasx
MACHINE0_AAS_ID=urn:uuid:6475_0111_2062_9689
MACHINE0_AGENT_ID=SMIA_agent@ejabberd
MACHINE0_PASSWD=change_me

# ── Machine 1 ────────────────────────────────────────────────────
MACHINE1_AAS_FILE=LEGO_machine1_case0.aasx
MACHINE1_AAS_ID=urn:uuid:6475_0111_2062_0001
MACHINE1_AGENT_ID=smia_machine1@ejabberd
MACHINE1_PASSWD=change_me

# ── Machine 2 ────────────────────────────────────────────────────
MACHINE2_AAS_FILE=LEGO_machine2_case0.aasx
MACHINE2_AAS_ID=urn:uuid:6475_0111_2062_0002
MACHINE2_AGENT_ID=smia_machine2@ejabberd
MACHINE2_PASSWD=change_me

# ── Machine 3 — Red duplicate (negotiation testing) ─────────────
# AASX must be created in AASX Package Explorer: color="red", AID pick href includes ?machine=smia_machine3
MACHINE3_AAS_FILE=LEGO_machine3_case0.aasx
MACHINE3_AAS_ID=urn:uuid:6475_0111_2062_0003
MACHINE3_AGENT_ID=smia_machine3@ejabberd
MACHINE3_PASSWD=change_me

# ── Machine 4 — Blue duplicate (negotiation testing) ─────────────
# AASX must be created in AASX Package Explorer: color="blue", AID pick href includes ?machine=smia_machine4
MACHINE4_AAS_FILE=LEGO_machine4_case0.aasx
MACHINE4_AAS_ID=urn:uuid:6475_0111_2062_0004
MACHINE4_AGENT_ID=smia_machine4@ejabberd
MACHINE4_PASSWD=change_me

# ── Machine 5 — Multicolour red+blue (negotiation testing) ───────
# AASX must be created in AASX Package Explorer: color="red,blue", AID pick href includes ?machine=smia_machine5
MACHINE5_AAS_FILE=LEGO_machine5_case0.aasx
MACHINE5_AAS_ID=urn:uuid:6475_0111_2062_0005
MACHINE5_AGENT_ID=smia_machine5@ejabberd
MACHINE5_PASSWD=change_me

# ── Orchestrator ─────────────────────────────────────────────────
ORCH_AAS_FILE=SMIA_orchestrator.aasx
ORCH_AAS_ID=urn:uuid:8888_0001_2026_0001
ORCH_AGENT_ID=smia_orch@ejabberd
ORCH_PASSWD=change_me

# ── Operator GUI ─────────────────────────────────────────────────
OPERATOR_AAS_FILE=SMIA_Operator_article.aasx
OPERATOR_AGENT_ID=operator001@ejabberd
OPERATOR_PASSWD=change_me

# ── Node-RED ──────────────────────────────────────────────────────
# Internal Docker service URL — do not change unless you rename the service.
# SMIA machine agents call this URL to check machine availability (FIPA-CNP).
NODERED_URL=http://nodered:1880
# Credential encryption key for Node-RED — any random string, keep consistent
# across restarts (changing it invalidates stored credentials).
NODERED_CREDENTIAL_SECRET=change_me_in_production

# ── MQTT Bridge (informational) ───────────────────────────────────
# The actual bridge target is configured in:
#   my_models/mosquitto/conf.d/bridge.conf  (edit the 'address' line)
# These variables document the intended target for reference.
MACHINE_MQTT_HOST=192.168.155.10
MACHINE_MQTT_PORT=1883
